# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Backend selection:
#   cortensor  -> Cortensor Portal (submission target), model FINANCE_MODEL (gemma4)
#   lapakvip   -> custom OpenAI-compatible endpoint (development)
FINANCE_BACKEND=cortensor
FINANCE_MODEL=gemma4

# LapakVIP (only used when FINANCE_BACKEND=lapakvip)
# FINANCE_BASE_URL=https://router.lapakvip.com/api/v1
# OPENAI_COMPATIBLE_API_KEY=

# Cortensor Portal credential (model backend). Portal endpoint: https://api.cortensor.app/v1
CORTENSOR_API_KEY=

# Absolute path to the SQLite database file (optional; defaults to ./finance.db)
# FINANCE_DB=/absolute/path/to/finance.db

# Path to the OpenMinion agents.json this project uses (optional; defaults to ./openminion/agents.json)
# OPENMINION_CONFIG=/absolute/path/to/agents.json
