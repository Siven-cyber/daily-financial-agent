# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Cortensor Portal credential (model backend). Portal endpoint: https://api.cortensor.app/v1
CORTENSOR_API_KEY=

# Model id served by Cortensor Portal
FINANCE_MODEL=gemma4

# Absolute path to the SQLite database file
FINANCE_DB=/root/finance-agent/finance.db

# Path to the OpenMinion agents.json this project uses
OPENMINION_CONFIG=/root/finance-agent/openminion/agents.json
